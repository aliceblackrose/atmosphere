<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Atmosphere.MainWindow"
        Title="Atmosphere  •  7 Days to Die Mod Launcher"
        Icon="/Assets/icon.png"
        Width="1320" Height="860" MinWidth="980" MinHeight="680"
        Background="#0D1423">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Branded masthead -->
    <Border Grid.Row="0" Background="#10192C" BorderBrush="#29344D"
            BorderThickness="0,0,0,1" Padding="28,16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <Border Background="#26304B" CornerRadius="13" Width="58" Height="58">
            <Image Source="/Assets/icon.png" Width="53" Height="53" Stretch="Uniform"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="ATMOSPHERE" FontSize="21" FontWeight="Bold" LetterSpacing="2"
                       Foreground="#F2F4FF"/>
            <TextBlock Text="Your wasteland. Your rules." FontSize="12" Foreground="#9AA9C1"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border BorderBrush="#53649A" Background="#212C47" BorderThickness="1"
                  CornerRadius="16" Padding="12,7">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="7" Height="7" Fill="#71D6AE" VerticalAlignment="Center"/>
              <TextBlock Text="DESKTOP PREVIEW" FontSize="11" FontWeight="Bold" Foreground="#B7C9F0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar navigation via accessible, keyboard-friendly Avalonia tabs -->
    <TabControl x:Name="MainTabs" Grid.Row="1" TabStripPlacement="Left"
                Background="Transparent" BorderThickness="0" Padding="0"
                SelectedIndex="0" Margin="10,12,14,12">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <PathIcon Width="20" Height="20" Data="M3 10 L12 3 L21 10 L21 21 L14 21 L14 15 L10 15 L10 21 L3 21 Z"/>
            <TextBlock Text="Overview" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="22" Margin="16,8,12,28">
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="COMMAND CENTER"/>
              <TextBlock Classes="page-title" Text="Welcome to Atmosphere"/>
              <TextBlock Classes="muted"
                         Text="A clearer way to organize your wasteland. Pick a game, curate mods, and launch on your terms."/>
            </StackPanel>
            <Border CornerRadius="19" Padding="26" BorderBrush="#4D5793" BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#292D61" Offset="0"/>
                  <GradientStop Color="#192849" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
                <StackPanel Grid.Column="0" Spacing="13">
                  <TextBlock Text="READY FOR YOUR NEXT RUN" FontSize="11" FontWeight="Bold"
                             Foreground="#A5ADF5"/>
                  <TextBlock Text="7 Days to Die" FontSize="31" FontWeight="Bold" Foreground="#FFFFFF"/>
                  <TextBlock x:Name="OverviewGameStatusText" Text="Checking game installation..."
                             Foreground="#D7DEF3" TextWrapping="Wrap"/>
                  <TextBlock x:Name="OverviewGamePathText" Text="Game path not selected"
                             Foreground="#9CB0D3" TextWrapping="Wrap" FontSize="12" MaxWidth="500"/>
                  <WrapPanel>
                    <Button Classes="primary" Content="Play vanilla" Margin="0,0,10,10"
                            Click="OnLaunchClick"/>
                    <Button Classes="subtle" Content="Manage game" Margin="0,0,10,10"
                            Click="OnNavigateGameClick"/>
                  </WrapPanel>
                </StackPanel>
                <Image Grid.Column="1" Source="/Assets/icon.png" Width="152" Height="152"
                       Stretch="Uniform" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="panel" Padding="20">
                <StackPanel Spacing="9">
                  <TextBlock Classes="eyebrow" Text="PROFILES"/>
                  <TextBlock x:Name="OverviewProfileCountText" Text="0" FontSize="29"
                             FontWeight="Bold" Foreground="#F4F6FF"/>
                  <TextBlock Classes="muted" Text="Your personalized setups" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel" Padding="20">
                <StackPanel Spacing="9">
                  <TextBlock Classes="eyebrow" Text="SELECTED PROFILE MODS"/>
                  <TextBlock x:Name="OverviewModCountText" Text="0" FontSize="29"
                             FontWeight="Bold" Foreground="#F4F6FF"/>
                  <TextBlock Classes="muted" Text="Enabled and disabled" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="panel" Padding="20">
                <StackPanel Spacing="9">
                  <TextBlock Classes="eyebrow" Text="CURRENT PROFILE"/>
                  <TextBlock x:Name="OverviewSelectedProfileText" Text="None" FontSize="18"
                             FontWeight="SemiBold" Foreground="#F4F6FF" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Classes="muted" Text="Switch in Profiles" FontSize="12"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <Border Grid.Column="0" Classes="panel" Padding="22">
                <StackPanel Spacing="14">
                  <TextBlock Classes="section-title" Text="Quick actions"/>
                  <Button Content="Create or manage profiles" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Click="OnNavigateProfilesClick"/>
                  <Button Content="Browse installed modlets" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Click="OnNavigateModsClick"/>
                  <Button Content="Discover releases on GitHub" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Click="OnNavigateOnlineClick"/>
                  <Button Classes="subtle" Content="Refresh dashboard" HorizontalAlignment="Stretch"
                          Click="OnRefreshOverviewClick"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel" Padding="22">
                <StackPanel Spacing="12">
                  <TextBlock Classes="section-title" Text="How it works"/>
                  <TextBlock Text="01   Locate your game in the Game section"
                             Foreground="#CAD6EB" TextWrapping="Wrap"/>
                  <TextBlock Text="02   Create a profile and install your mod ZIPs"
                             Foreground="#CAD6EB" TextWrapping="Wrap"/>
                  <TextBlock Text="03   Launch the profile you want to play"
                             Foreground="#CAD6EB" TextWrapping="Wrap"/>
                  <Border Classes="soft-panel" Padding="13" Margin="0,7,0,0">
                    <TextBlock Text="Modded profiles keep their user data separate. Game-root mods may still load; use a clean install for isolation."
                               Foreground="#ACBBD1" FontSize="12" TextWrapping="Wrap"/>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <PathIcon Width="20" Height="20" Data="M4 5 L20 5 L22 9 L22 19 L2 19 L2 9 Z M7 12 L10 12 M8.5 10.5 L8.5 13.5 M16 11 L17 11 L17 13 L16 13 Z"/>
            <TextBlock Text="Game" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="20" Margin="16,8,12,28">
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="GAME SETUP"/>
              <TextBlock Classes="page-title" Text="Your game installation"/>
              <TextBlock Classes="muted"
                         Text="Connect a Steam installation or a separate copy. Atmosphere never writes modlets to the original game folder."/>
            </StackPanel>
            <Border Classes="panel" Padding="24">
              <StackPanel Spacing="16">
                <TextBlock Classes="section-title" Text="Installation directory"/>
                <TextBlock Classes="muted" Text="Choose the folder containing the 7 Days to Die executable."/>
                <TextBox x:Name="GamePathTextBox" Watermark="Path to your 7 Days to Die folder"
                         TextChanged="OnGamePathChanged"/>
                <WrapPanel>
                  <Button Classes="primary" Content="Browse folder" Margin="0,0,10,10"
                          Click="OnBrowseClick"/>
                  <Button Content="Auto-detect" Margin="0,0,10,10" Click="OnDetectClick"/>
                  <Button Content="Save location" Margin="0,0,10,10" Click="OnSaveClick"/>
                  <Button x:Name="OpenFolderButton" Content="Open folder" Margin="0,0,10,10"
                          Click="OnOpenFolderClick"/>
                </WrapPanel>
                <Border Classes="soft-panel" Padding="16">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="GameStatusText" FontWeight="SemiBold" Foreground="#DFFAEF"/>
                    <TextBlock x:Name="GameDetailsText" Foreground="#B3C4DE" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Button x:Name="LaunchButton" Classes="primary" Content="Launch vanilla with Steam"
                        HorizontalAlignment="Left" Click="OnLaunchClick"/>
              </StackPanel>
            </Border>
            <Border Classes="panel" Padding="24">
              <StackPanel Spacing="13">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="section-title" Text="Existing game modlets"/>
                  <Border Background="#273A43" CornerRadius="12" Padding="9,3">
                    <TextBlock Text="READ ONLY" Foreground="#A6EAD1" FontSize="10" FontWeight="Bold"/>
                  </Border>
                </StackPanel>
                <TextBlock Classes="muted" Text="Inspect modlets already in your game installation or default user-data folder."/>
                <Button Classes="subtle" Content="Refresh inventory" HorizontalAlignment="Left"
                        Click="OnRefreshGameModsClick"/>
                <ListBox x:Name="GameModList" MinHeight="170" MaxHeight="300"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <PathIcon Width="20" Height="20" Data="M12 3 A4 4 0 1 1 12 11 A4 4 0 1 1 12 3 Z M3 21 L3 17 C3 13 21 13 21 17 L21 21 Z"/>
            <TextBlock Text="Profiles" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="20" Margin="16,8,12,28">
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="PLAY YOUR WAY"/>
              <TextBlock Classes="page-title" Text="Profiles and game copies"/>
              <TextBlock Classes="muted"
                         Text="Keep your mod sets and saves organized, or create an isolated game copy for an overhaul."/>
            </StackPanel>
            <Grid ColumnDefinitions="300,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="16">
                <Border Classes="panel" Padding="18">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="My profiles"/>
                    <ListBox x:Name="ProfileList" Height="220"
                             SelectionChanged="OnProfileSelectionChanged"/>
                    <TextBox x:Name="NewProfileNameTextBox" Watermark="Name a new profile"/>
                    <Button Classes="primary" Content="Create profile" Click="OnCreateProfileClick"/>
                  </StackPanel>
                </Border>
                <Border Classes="panel" Padding="18">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Archived profiles"/>
                    <TextBlock Classes="muted" FontSize="12" Text="Restore an old setup or permanently remove its data."/>
                    <ListBox x:Name="ArchivedProfilesList" Height="116"/>
                    <Button Classes="subtle" Content="Restore selected" Click="OnRestoreProfileClick"/>
                    <Button Classes="danger" Content="Delete selected archive"
                            Click="OnDeleteArchivedProfileClick"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="16">
                <Border Classes="panel" Padding="22">
                  <StackPanel Spacing="13">
                    <TextBlock Classes="section-title" Text="Active profile"/>
                    <TextBlock x:Name="SelectedProfileText" Text="Select or create a profile."
                               Foreground="#C9D6E9" TextWrapping="Wrap"/>
                    <TextBox x:Name="RenameProfileTextBox" Watermark="Rename profile"/>
                    <Button Classes="subtle" Content="Save name" HorizontalAlignment="Left"
                            Click="OnRenameProfileClick"/>
                    <TextBox x:Name="VersionNoteTextBox" Watermark="Version note (e.g. V2.0)"/>
                    <Button Content="Use selected game folder" HorizontalAlignment="Left"
                            Click="OnSetProfileGameClick"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Content="Launch this profile"
                              Click="OnLaunchProfileClick"/>
                      <Button Classes="subtle" Content="Archive profile"
                              Click="OnArchiveProfileClick"/>
                    </StackPanel>
                    <CheckBox x:Name="NoEacCheckBox"
                              Content="Launch without EAC (required for DLL/code mods)"/>
                    <TextBlock Classes="muted" FontSize="12"
                               Text="Mods inside the game's own Mods folder may still load. A separate game copy is recommended for big overhauls."/>
                  </StackPanel>
                </Border>
                <Border Classes="panel" Padding="22">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Game copy"/>
                    <TextBlock Classes="muted"
                               Text="Make a self-contained copy for overhauls. This uses additional disk space but leaves Steam files untouched."/>
                    <WrapPanel>
                      <Button Content="Create isolated game copy" Margin="0,0,10,8"
                              Click="OnCreateGameCopyClick"/>
                      <Button x:Name="CancelGameCopyButton" Classes="subtle"
                              Content="Cancel copy" IsEnabled="False"
                              Click="OnCancelGameCopyClick"/>
                    </WrapPanel>
                    <TextBlock x:Name="GameCopyStatusText" Classes="muted"
                               Text="No copy operation running."/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            <Border Classes="panel" Padding="22">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="section-title" Text="Storage and cleanup"/>
                    <TextBlock Classes="muted" Text="Inspect disk usage and remove Atmosphere-managed files."/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="subtle" Content="Refresh storage"
                          Click="OnRefreshStorageClick"/>
                </Grid>
                <TextBlock x:Name="ProfileStorageText" Classes="muted"
                           Text="Select a profile and refresh storage usage."/>
                <WrapPanel>
                  <Button Content="Open profile folder" Margin="0,0,10,10"
                          Click="OnOpenProfileFolderClick"/>
                  <Button Classes="subtle" Content="Delete owned GameCopy" Margin="0,0,10,10"
                          Click="OnDeleteGameCopyClick"/>
                  <Button Classes="subtle" Content="Clear backups" Margin="0,0,10,10"
                          Click="OnClearProfileBackupsClick"/>
                  <Button Classes="danger" Content="Permanently delete profile"
                          Margin="0,0,10,10" Click="OnDeleteProfileClick"/>
                </WrapPanel>
                <Border Background="#3C2937" BorderBrush="#6C435B" BorderThickness="1"
                        CornerRadius="9" Padding="12">
                  <TextBlock Text="Permanent deletion removes saves, mods and owned game copies. Confirmation is required; external Steam installations are never deleted."
                             Foreground="#F2C8D3" FontSize="12" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <PathIcon Width="20" Height="20" Data="M12 2 L22 7 L12 12 L2 7 Z M2 12 L12 17 L22 12 L22 17 L12 22 L2 17 Z"/>
            <TextBlock Text="My Mods" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="20" Margin="16,8,12,28">
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="MOD COLLECTION"/>
              <TextBlock Classes="page-title" Text="Your mod library"/>
              <TextBlock Classes="muted"
                         Text="Install entire modpacks or individual modlets, and enable or disable them per profile."/>
            </StackPanel>
            <Border Classes="panel" Padding="22">
              <StackPanel Spacing="15">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="section-title" Text="Installed modlets"/>
                    <TextBlock x:Name="ModProfileLabel" Foreground="#AAB9E4"
                               Text="Select a profile to manage modlets."/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="subtle" Content="Refresh"
                          Click="OnRefreshModsClick"/>
                </Grid>
                <TextBlock Classes="muted" FontSize="12"
                           Text="Import multiple ZIPs at once or a ZIP containing several modlets. Limits: 16 GiB ZIP, 64 GiB expanded. Original game files stay untouched."/>
                <ListBox x:Name="ModsList" Height="275"
                         SelectionChanged="OnModSelectionChanged"/>
                <Border Classes="soft-panel" Padding="14">
                  <TextBlock x:Name="ModDetailsText" Foreground="#CED9EA" TextWrapping="Wrap"
                             Text="Select a mod to see details and compatibility warnings."/>
                </Border>
                <CheckBox x:Name="ReplaceExistingCheckBox"
                          Content="Back up and replace existing mods on install"/>
                <WrapPanel>
                  <Button Classes="primary" Content="Install ZIP modpack(s)"
                          Margin="0,0,10,10" Click="OnInstallZipClick"/>
                  <Button Content="Enable" Margin="0,0,10,10" Click="OnEnableModClick"/>
                  <Button Content="Disable" Margin="0,0,10,10" Click="OnDisableModClick"/>
                  <Button Classes="subtle" Content="Archive mod"
                          Margin="0,0,10,10" Click="OnArchiveModClick"/>
                  <Button Classes="subtle" Content="Find source"
                          Margin="0,0,10,10" Click="OnFindModSourceClick"/>
                </WrapPanel>
                <TextBlock Classes="muted" FontSize="12"
                           Text="Archived modlets remain in Backups/Removed until you explicitly clear backups."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <PathIcon Width="20" Height="20" Data="M12 2 A10 10 0 1 1 12 22 A10 10 0 1 1 12 2 Z M2 12 L22 12 M12 2 C6 8 6 16 12 22 M12 2 C18 8 18 16 12 22"/>
            <TextBlock Text="Discover" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="20" Margin="16,8,12,28">
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="FIND YOUR NEXT MOD"/>
              <TextBlock Classes="page-title" Text="Browse and install"/>
              <TextBlock Classes="muted"
                         Text="Find community GitHub repositories, inspect official release assets, and install directly to the selected profile."/>
            </StackPanel>
            <Border Classes="panel" Padding="23">
              <StackPanel Spacing="13">
                <TextBlock Classes="section-title" Text="Search GitHub repositories"/>
                <TextBlock Classes="muted" Text="Search results are public and unverified. Check the author and game-version compatibility before installing."/>
                <TextBox x:Name="CatalogSearchTextBox" Watermark="Try: vehicles, quests, UI, inventory..."/>
                <WrapPanel>
                  <Button Classes="primary" Content="Search repositories"
                          Margin="0,0,10,10" Click="OnCatalogSearchClick"/>
                  <Button Classes="subtle" Content="Use selected result"
                          Margin="0,0,10,10" Click="OnUseCatalogResultClick"/>
                </WrapPanel>
                <ListBox x:Name="CatalogResultsList" Height="168"/>
              </StackPanel>
            </Border>
            <Border Classes="panel" Padding="23">
              <StackPanel Spacing="15">
                <TextBlock Classes="section-title" Text="GitHub Releases"/>
                <TextBlock Classes="muted" Text="Choose a trusted repository, then inspect its latest ZIP release assets."/>
                <TextBox x:Name="GitHubUrlTextBox" Watermark="https://github.com/owner/repository"/>
                <Button Classes="subtle" Content="Check latest release"
                        HorizontalAlignment="Left" Click="OnCheckReleaseClick"/>
                <Border Classes="soft-panel" Padding="13">
                  <TextBlock x:Name="ReleaseInfoText" Foreground="#C9D7EB"
                             TextWrapping="Wrap" Text="No release selected."/>
                </Border>
                <TextBlock Classes="eyebrow" Text="AVAILABLE ZIP ASSETS"/>
                <ListBox x:Name="ReleaseAssetsList" Height="176"
                         SelectionChanged="OnReleaseAssetSelectionChanged"/>
                <TextBlock x:Name="SelectedAssetText" Classes="muted"
                           Text="Select a ZIP asset to install into the selected profile."/>
                <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100"
                             Height="7" Value="0"/>
                <WrapPanel>
                  <Button x:Name="DownloadInstallButton" Classes="primary"
                          Content="Download and install" Margin="0,0,10,10"
                          Click="OnDownloadInstallClick"/>
                  <Button x:Name="CancelDownloadButton" Classes="subtle"
                          Content="Cancel download" IsEnabled="False"
                          Margin="0,0,10,10" Click="OnCancelDownloadClick"/>
                </WrapPanel>
                <TextBlock x:Name="OnlineStatusText" Classes="muted"
                           Text="No downloads running."/>
                <TextBlock Classes="muted" FontSize="12"
                           Text="A SHA-256 hash is recorded for downloads, but it is not a publisher signature. Only install code mods from trusted sources."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Compact, persistent activity/status footer -->
    <Border Grid.Row="2" Background="#10192B" BorderBrush="#28334A"
            BorderThickness="0,1,0,0" Padding="18,10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#7DDCB8" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="GlobalStatusText" Text="Ready."
                   Foreground="#DEE7F7" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="ATMOSPHERE • COMMUNITY PREVIEW"
                   FontSize="10" Foreground="#8393AE" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
