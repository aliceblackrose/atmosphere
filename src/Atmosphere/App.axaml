<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Atmosphere.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- Unified Atmosphere dark theme; all existing controls share consistent states. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI,Inter,Arial"/>
      <Setter Property="Foreground" Value="#E8EEFA"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Background" Value="#253149"/>
      <Setter Property="Foreground" Value="#E6EDF9"/>
      <Setter Property="BorderBrush" Value="#38445E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#35425D"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6B68EA"/>
      <Setter Property="BorderBrush" Value="#8382FA"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#8180F5"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#3D2535"/>
      <Setter Property="BorderBrush" Value="#895064"/>
      <Setter Property="Foreground" Value="#FFCAD4"/>
    </Style>
    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#593247"/>
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="#192337"/>
      <Setter Property="BorderBrush" Value="#303B50"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#121B2E"/>
      <Setter Property="Foreground" Value="#F4F6FF"/>
      <Setter Property="BorderBrush" Value="#35425A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#8888FD"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#10192A"/>
      <Setter Property="BorderBrush" Value="#26334A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#D9E2F3"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#192338"/>
      <Setter Property="BorderBrush" Value="#2A3650"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style Selector="Border.soft-panel">
      <Setter Property="Background" Value="#131D30"/>
      <Setter Property="BorderBrush" Value="#27334B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="29"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#F4F6FF"/>
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#9AA9C9"/>
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F0F4FD"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#ADBBD2"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Width" Value="230"/>
      <Setter Property="Height" Value="54"/>
      <Setter Property="Padding" Value="15,12"/>
      <Setter Property="Margin" Value="8,3"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="#A9B9D0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#263653"/>
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
  </Application.Styles>
</Application>
